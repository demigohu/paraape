# cp .env.example .env   (ponder.config loads .env + optional .env.local)
# or: set -a && source ../contracts-solidity/.env && set +a

# HTTP RPC for Robinhood testnet (chain 46630)
PONDER_RPC_URL_46630=
# alias (keeper / forge .env)
# ROBINHOOD_TESTNET_RPC_URL=

# From DeployParaape logs (or FACTORY_ADDRESS from contracts-solidity/.env)
MARKET_FACTORY_ADDRESS=
# Factory deploy block, decimal (same as keeper MARKET_FACTORY_FROM_BLOCK)
MARKET_FACTORY_START_BLOCK=

PRICE_OBSERVER_ADDRESS=

# Optional comma-separated poolId(s) merged into GET /keeper/targets (e.g. WETH/USDG quote pool)
# KEEPER_EXTRA_POOL_REFS=

# Required for `pnpm start` (Ponder 0.17+). Local hacking: use `pnpm dev` instead.
DATABASE_SCHEMA=

# Production VPS: Postgres (optional; dev uses embedded PGlite)
# DATABASE_URL=

# API default http://localhost:42069 — /markets, /keeper/targets, /graphql
