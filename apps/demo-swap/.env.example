# cp .env.example .env — fill PRIVATE_KEY locally (never commit .env)

CHAIN_ID=
ROBINHOOD_TESTNET_RPC_URL=

PRIVATE_KEY=
# Second wallet. Trades DEMO_MEME_ADDRESS_2. Empty shares PRIVATE_KEY.
PRIVATE_KEY_2=

# First meme/USDG pool, then an optional second pool
DEMO_MEME_ADDRESS=
DEMO_MEME_ADDRESS_2=
USDG_ADDRESS=

# Reference only — NOT used by demo-swap (liquidity init/add only)
# V4LiquidityRouter from DeployParaape:
# V4_ROUTER_ADDRESS=

# V4SwapRouter from DeployParaape — NOT V4_ROUTER_ADDRESS (liquidity)
V4_SWAP_ROUTER_ADDRESS=
DEPLOY_SWAP_ROUTER=
POOL_MANAGER_ADDRESS=

# Only if SIM_RECORD_AFTER_SWAP=1 (normally keeper records — leave record off)
PRICE_OBSERVER_ADDRESS=

# Optional context (not read by demo-swap)
# DEMO_VAULT_ADDRESS=
# FACTORY_ADDRESS=

# 0, or SIM_CONTINUOUS=1, runs until Ctrl+C
SIM_CONTINUOUS=
SIM_SWAP_COUNT=
SIM_USDG_PER_SWAP=
SIM_RECORD_AFTER_SWAP=
SIM_SLEEP_MS=
# How long one market keeps buying, or selling, before it flips. Longer than the keeper interval (~35s) so samples see a real tick move.
SIM_LEG_MS=
# 1 = only USDG→PAPE (oracle vol without crashing PAPE USD price on thin demo LP)
SIM_BUY_ONLY=
# 1 = only PAPE→USDG. One large leg crashes the spot for a settle test.
SIM_SELL_ONLY=
