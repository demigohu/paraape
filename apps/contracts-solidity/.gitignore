# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/
# Keep run-latest.json; drop timestamped duplicate broadcasts
/broadcast/**/run-[0-9]*.json

# Forge cache may contain private keys / tx payloads — never commit
# (cache/ is listed above)

