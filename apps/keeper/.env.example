# cp .env.example .env — or: set -a && source ../contracts-solidity/.env && set +a

ROBINHOOD_TESTNET_RPC_URL=https://your-robinhood-testnet-rpc
PRIVATE_KEY=0x

# On-chain record txs
PRICE_OBSERVER_ADDRESS=

# Markets / pools / vaults — from Ponder (required)
KEEPER_INDEXER_URL=http://127.0.0.1:42069
# KEEPER_MARKETS_URL=http://127.0.0.1:42069/keeper/targets

KEEPER_INDEXER_SYNC_MS=120000
# KEEPER_INDEXER_WAIT_READY=1
# KEEPER_INDEXER_STARTUP_TIMEOUT_MS=600000
# KEEPER_INDEXER_REQUIRE_READY=1
# KEEPER_INDEXER_TIMEOUT_MS=15000

# Optional manual extras (merged with indexer; not removed on failed poll)
# POOL_REFS=
# VAULT_ADDRESSES=

RECORD_INTERVAL_MS=35000
CHAIN_ID=46630
