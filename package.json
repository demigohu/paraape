{
  "name": "paraape",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "contracts:build": "pnpm --filter @paraape/contracts-solidity build",
    "contracts:test": "pnpm --filter @paraape/contracts-solidity test",
    "keeper": "pnpm --filter @paraape/keeper start",
    "indexer:dev": "pnpm --filter @paraape/indexer dev",
    "indexer": "pnpm --filter @paraape/indexer start",
    "web": "pnpm --filter web dev"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.4",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
