# Copy to .env (never commit .env — already in .gitignore)
# cp .env.example .env

# Robinhood Chain Testnet (chain ID 46630)
ROBINHOOD_TESTNET_RPC_URL=

# Deployer wallet (testnet only — no real funds)
PRIVATE_KEY=

# PRD §15 — production Paxos USDG on Robinhood testnet (faucet-limited)
# USDG_ADDRESS=

# Recommended testnet redeploy: run DeployTestnetMocks.s.sol first, then paste addresses here
USDG_ADDRESS=
CHAINLINK_ETH_USD_FEED=
MOCK_USDG_MINT=
MOCK_ETH_USD_8DEC=

WETH_ADDRESS=
POOL_MANAGER_ADDRESS=
# Leave zero when using CHAINLINK_ETH_USD_FEED for WETH→USDG conversion
WETH_USDG_POOL_ID=

# Optional; defaults to deployer if unset
GUARDIAN_ADDRESS=

# After DeployParaape.s.sol
STYLUS_RISK_ENGINE=
FACTORY_ADDRESS=
LOCKER_ADDRESS=
V4_ROUTER_ADDRESS=
WETH_IS_CURRENCY0=

# Leave STYLUS_RISK_ENGINE empty while new Stylus activations are paused.
# DeployParaape then deploys ParaapeRiskEngine (B2/B3) and wraps it in BoundedRiskEngine.

# DeployDemoMarket — Pons graduate: 1B PAPE in LP + 10k USDG (tick from ratio, not manual).
DEMO_LP_PAPE=
DEMO_POOL_USDG=
# Optional override init tick (multiple of 60). Leave unset to derive from LP amounts.
# DEMO_INIT_TICK=

# Optional — filled after DeployDemoMarket (for scripts / frontend / docs)
# DEMO_MEME_ADDRESS=
# DEMO_VAULT_ADDRESS=
# DEMO_POOL_ID=

# Demo pool swap volume → apps/demo-swap (Node)

# apps/keeper — oracle record bot (VPS)
# PRICE_OBSERVER_ADDRESS=
# MARKET_FACTORY_ADDRESS=   # FACTORY_ADDRESS — auto-subscribe MarketCreated
# MARKET_FACTORY_FROM_BLOCK=  # factory deploy block (optional, speeds backfill)
# POOL_REFS=                # optional static poolId(s)

# apps/indexer — Ponder (VPS)
# PONDER_RPC_URL_46630=       # or reuse ROBINHOOD_TESTNET_RPC_URL
# MARKET_FACTORY_START_BLOCK=
# DATABASE_URL=               # Postgres in production

# SetMockEthUsd.s.sol — uses CHAINLINK_ETH_USD_FEED when updating mock price
# MOCK_ETH_USD_8DEC=
